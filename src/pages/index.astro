---
import BaseLayout from '../layouts/BaseLayout.astro';import {tools,byCat,categoryMeta} from '../data/tools';import {guides} from '../data/guides';
const popular=['roi-calculator','json-formatter','password-generator','qr-code-generator','roas-calculator','word-counter'].map(s=>tools.find(t=>t.slug===s)!);
---
<BaseLayout title="Veldeonix Labs | Free Online Digital Tools" description="Fast, privacy-focused online tools and practical guides for developers, marketers, and digital creators." canonical="/">
<section class="hero"><div class="container"><span class="eyebrow"><span class="dot"></span> Free browser-based utilities</span><h1>Tools built for everyday digital work.</h1><p>Fast, simple, and privacy-focused tools for developers, marketers, and digital creators. No account required.</p><div class="search-box"><span class="search-icon">⌕</span><input id="q" type="search" placeholder="Search ROI, JSON, QR, password..."></div><div class="hero-actions"><a class="btn btn-primary" href="/tools/">Explore all tools</a><a class="btn" href="/how-we-create-content/">How Veldeonix works</a></div></div></section>
<section class="section-tight"><div class="container"><div class="section-head"><div><h2>Popular tools</h2><p>Useful utilities that run directly in your browser.</p></div><a class="text-link" href="/tools/">View all →</a></div><div class="grid grid-3" id="popular">{popular.map(t=><a class="card card-hover tool-card item" href={`/tools/${t.slug}/`} data-search={`${t.name} ${t.description}`.toLowerCase()}><div class="tool-icon">{t.icon}</div><h3>{t.name}</h3><p>{t.description}</p><div class="meta"><span class="badge">{t.cat}</span><span>Open tool →</span></div></a>)}<div class="empty hidden" id="none">No matching tool in this shortlist. <a class="text-link" href="/tools/">Search all tools</a>.</div></div></div></section>
<section class="section"><div class="container"><div class="section-head"><div><h2>Browse by category</h2><p>Each group has a clear purpose and a small, focused tool set.</p></div></div><div class="grid grid-3">{(['developer','marketing','productivity'] as const).map(c=><a class="card card-hover" href={`/tools/${c}/`}><span class="badge">{byCat(c).length} tools</span><h3>{categoryMeta[c].name}</h3><p class="muted">{categoryMeta[c].description}</p></a>)}</div></div></section>
<section class="section-tight"><div class="container"><div class="features"><div class="feature"><div class="mark">✓</div><b>Free to use</b><span>No account required for core tools.</span></div><div class="feature"><div class="mark">⌁</div><b>Local-first</b><span>Current tool inputs stay in the browser.</span></div><div class="feature"><div class="mark">ƒ</div><b>Clear methods</b><span>Calculators show formulas and limits.</span></div><div class="feature"><div class="mark">↗</div><b>Practical guides</b><span>Supporting content explains the result.</span></div></div></div></section>
<section class="section"><div class="container"><div class="section-head"><div><h2>Latest guides</h2><p>Explanations written to support actual tool usage.</p></div><a class="text-link" href="/guides/">All guides →</a></div><div class="grid grid-3">{guides.slice(0,6).map(g=><a class="card card-hover guide-card" href={`/guides/${g.slug}/`}><span class="badge">{g.cat}</span><h3>{g.title}</h3><p>{g.description}</p><span class="text-link">Read guide →</span></a>)}</div></div></section>
</BaseLayout>
<script>
const q=document.querySelector<HTMLInputElement>('#q');
const items=[...document.querySelectorAll<HTMLElement>('#popular .item')];
const none=document.querySelector<HTMLElement>('#none');
q?.addEventListener('input',()=>{const s=q.value.trim().toLowerCase();let n=0;items.forEach(x=>{const ok=!s||(x.dataset.search??'').includes(s);x.classList.toggle('hidden',!ok);if(ok)n++});none?.classList.toggle('hidden',n>0)});
</script>
