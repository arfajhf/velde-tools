---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {tools,related,categoryMeta,type Tool} from '../../data/tools';
export function getStaticPaths(){return tools.map(tool=>({params:{slug:tool.slug},props:{tool}}));}
const {tool}=Astro.props as {tool:Tool};const rel=related(tool);const cat=categoryMeta[tool.cat];
const jsonLd={'@context':'https://schema.org','@type':'WebApplication',name:tool.name,description:tool.description,applicationCategory:'UtilitiesApplication',operatingSystem:'Any',url:`https://veldeonix.com/tools/${tool.slug}/`,offers:{'@type':'Offer',price:'0',priceCurrency:'USD'}};
const formula:Record<string,string>={
'roi-calculator':'ROI = ((Revenue - Cost) / Cost) × 100','roas-calculator':'ROAS = Attributed revenue / Ad spend','ctr-calculator':'CTR = (Clicks / Impressions) × 100','cpm-cpc-calculator':'CPM = (Ad spend / Impressions) × 1,000\nCPC = Ad spend / Clicks','json-formatter':'JSON.parse(input) → JSON.stringify(value, null, 2)','base64-encoder-decoder':'Text → UTF-8 bytes → Base64','uuid-generator':'Browser crypto.randomUUID() → UUID v4','unix-timestamp-converter':'JavaScript Date uses milliseconds from the Unix epoch','word-counter':'Reading time estimate = words / 200','password-generator':'Characters are selected with crypto.getRandomValues()','qr-code-generator':'Input text → local QR encoder → canvas','case-converter':'Text → word boundaries → selected case rule'};
const example:Record<string,string>={
'roi-calculator':'Cost 1,000 and revenue 1,500 produces profit 500 and ROI 50%.','roas-calculator':'Revenue 8,000 divided by ad spend 2,000 equals 4.0× ROAS, or 400%.','ctr-calculator':'500 clicks from 25,000 impressions produces a 2% CTR.','cpm-cpc-calculator':'Spend 1,000 with 200,000 impressions and 2,500 clicks produces CPM 5 and CPC 0.4.','json-formatter':'{"name":"Veldeonix","active":true} becomes readable multi-line JSON after formatting.','base64-encoder-decoder':'Hello encodes to SGVsbG8=.','uuid-generator':'0f8fad5b-d9cb-469f-a165-70867728950e follows the common UUID text shape.','unix-timestamp-converter':'A milliseconds value is roughly 1,000 times the equivalent seconds value.','word-counter':'A 1,000-word article is estimated as a 5-minute read at 200 words per minute.','password-generator':'A longer random password has a much larger possible search space than a short predictable password.','qr-code-generator':'Entering https://veldeonix.com creates a QR symbol representing that URL.','case-converter':'Veldeonix digital tools can become veldeonixDigitalTools, VeldeonixDigitalTools, or veldeonix-digital-tools.'};
---
<BaseLayout title={tool.name} description={tool.description} canonical={`/tools/${tool.slug}/`} jsonLd={jsonLd}>
<section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/tools/">Tools</a><span>/</span><a href={`/tools/${tool.cat}/`}>{cat.name}</a></div><h1>{tool.name}</h1><p>{tool.intro}</p></div></section>
<section class="section-tight"><div class="container tool-shell"><div>
<div class="tool-panel" data-tool={tool.slug}>
{tool.slug==='roi-calculator'&&<><div class="form-grid"><div class="field"><label>Investment cost</label><input class="input" id="a" type="number" min="0" step="any" placeholder="1000"/></div><div class="field"><label>Revenue</label><input class="input" id="b" type="number" min="0" step="any" placeholder="1500"/></div></div><div class="actions"><button class="btn btn-primary" id="run">Calculate ROI</button><button class="btn" id="reset">Reset</button></div><div class="result-grid"><div class="result-box"><span>ROI</span><strong id="r1">—</strong></div><div class="result-box"><span>Profit</span><strong id="r2">—</strong></div></div></>}
{tool.slug==='roas-calculator'&&<><div class="form-grid"><div class="field"><label>Advertising spend</label><input class="input" id="a" type="number" min="0" step="any" placeholder="2000"/></div><div class="field"><label>Attributed revenue</label><input class="input" id="b" type="number" min="0" step="any" placeholder="8000"/></div></div><div class="actions"><button class="btn btn-primary" id="run">Calculate ROAS</button><button class="btn" id="reset">Reset</button></div><div class="result-grid"><div class="result-box"><span>ROAS ratio</span><strong id="r1">—</strong></div><div class="result-box"><span>ROAS percentage</span><strong id="r2">—</strong></div></div></>}
{tool.slug==='ctr-calculator'&&<><div class="form-grid"><div class="field"><label>Clicks</label><input class="input" id="a" type="number" min="0" placeholder="500"/></div><div class="field"><label>Impressions</label><input class="input" id="b" type="number" min="0" placeholder="25000"/></div></div><div class="actions"><button class="btn btn-primary" id="run">Calculate CTR</button><button class="btn" id="reset">Reset</button></div><div class="result-grid"><div class="result-box"><span>CTR</span><strong id="r1">—</strong></div><div class="result-box"><span>Clicks per 1,000</span><strong id="r2">—</strong></div></div></>}
{tool.slug==='cpm-cpc-calculator'&&<><div class="form-grid"><div class="field"><label>Ad spend</label><input class="input" id="a" type="number" min="0" step="any" placeholder="1000"/></div><div class="field"><label>Impressions</label><input class="input" id="b" type="number" min="0" placeholder="200000"/></div><div class="field"><label>Clicks</label><input class="input" id="c" type="number" min="0" placeholder="2500"/></div></div><div class="actions"><button class="btn btn-primary" id="run">Calculate CPM & CPC</button><button class="btn" id="reset">Reset</button></div><div class="result-grid"><div class="result-box"><span>CPM</span><strong id="r1">—</strong></div><div class="result-box"><span>CPC</span><strong id="r2">—</strong></div></div></>}
{tool.slug==='json-formatter'&&<><div class="field"><label>JSON input</label><textarea class="textarea" id="text" spellcheck="false" placeholder='{"name":"Veldeonix","active":true}'></textarea></div><div class="actions"><button class="btn btn-primary" id="run">Format</button><button class="btn" id="alt">Minify</button><button class="btn" id="copy">Copy output</button><button class="btn" id="reset">Clear</button></div><pre class="output" id="out">Formatted JSON will appear here.</pre></>}
{tool.slug==='base64-encoder-decoder'&&<><div class="field"><label>Input</label><textarea class="textarea" id="text" placeholder="Type or paste text..."></textarea></div><div class="actions"><button class="btn btn-primary" id="run">Encode</button><button class="btn" id="alt">Decode</button><button class="btn" id="copy">Copy output</button><button class="btn" id="reset">Clear</button></div><pre class="output" id="out">Output will appear here.</pre></>}
{tool.slug==='uuid-generator'&&<><div class="field" style="max-width:220px"><label>How many UUIDs?</label><input class="input" id="count" type="number" min="1" max="20" value="5"/></div><div class="actions"><button class="btn btn-primary" id="run">Generate UUIDs</button><button class="btn" id="copy">Copy all</button></div><pre class="output" id="out">Click Generate UUIDs.</pre></>}
{tool.slug==='unix-timestamp-converter'&&<><div class="form-grid"><div class="field"><label>Unix timestamp</label><input class="input" id="ts" type="number" placeholder="Seconds or milliseconds"/></div><div class="field"><label>Local date and time</label><input class="input" id="date" type="datetime-local"/></div></div><div class="actions"><button class="btn btn-primary" id="run">Timestamp → Date</button><button class="btn" id="alt">Date → Timestamp</button><button class="btn" id="now">Use current time</button></div><div class="result-grid"><div class="result-box"><span>UTC / ISO</span><strong id="r1" style="font-size:17px">—</strong></div><div class="result-box"><span>Local</span><strong id="r2" style="font-size:17px">—</strong></div><div class="result-box"><span>Seconds</span><strong id="r3">—</strong></div><div class="result-box"><span>Milliseconds</span><strong id="r4">—</strong></div></div></>}
{tool.slug==='word-counter'&&<><div class="field"><label>Your text</label><textarea class="textarea" id="text" style="min-height:240px" placeholder="Start typing..."></textarea></div><div class="result-grid"><div class="result-box"><span>Words</span><strong id="r1">0</strong></div><div class="result-box"><span>Characters</span><strong id="r2">0</strong></div><div class="result-box"><span>No spaces</span><strong id="r3">0</strong></div><div class="result-box"><span>Sentences</span><strong id="r4">0</strong></div><div class="result-box"><span>Paragraphs</span><strong id="r5">0</strong></div><div class="result-box"><span>Reading time</span><strong id="r6">0 min</strong></div></div><div class="actions"><button class="btn" id="reset">Clear</button></div></>}
{tool.slug==='password-generator'&&<><div class="field"><label>Length: <span id="lenLabel">20</span></label><input id="len" type="range" min="8" max="64" value="20" style="accent-color:var(--brand)"/></div><div class="check-row"><label><input id="lower" type="checkbox" checked/> Lowercase</label><label><input id="upper" type="checkbox" checked/> Uppercase</label><label><input id="number" type="checkbox" checked/> Numbers</label><label><input id="symbol" type="checkbox" checked/> Symbols</label></div><div class="actions"><button class="btn btn-primary" id="run">Generate password</button><button class="btn" id="copy">Copy</button></div><div class="result-box" style="margin-top:18px"><span>Generated password</span><strong id="out" style="font-family:ui-monospace;font-size:18px">—</strong></div></>}
{tool.slug==='qr-code-generator'&&<><div class="field"><label>Text or URL</label><textarea class="textarea" id="text" style="min-height:120px" placeholder="https://veldeonix.com"></textarea></div><div class="actions"><button class="btn btn-primary" id="run">Generate QR code</button><button class="btn" id="download">Download PNG</button><button class="btn" id="reset">Clear</button></div><div style="display:grid;place-items:center;margin-top:20px;min-height:280px;border:1px solid var(--line);background:#fff;border-radius:16px"><canvas id="canvas" width="256" height="256"></canvas></div></>}
{tool.slug==='case-converter'&&<><div class="field"><label>Text</label><textarea class="textarea" id="text" style="min-height:220px" placeholder="Paste or type text..."></textarea></div><div class="actions"><button class="btn btn-primary" data-case="sentence">Sentence case</button><button class="btn" data-case="title">Title Case</button><button class="btn" data-case="upper">UPPERCASE</button><button class="btn" data-case="lower">lowercase</button><button class="btn" data-case="camel">camelCase</button><button class="btn" data-case="pascal">PascalCase</button><button class="btn" data-case="snake">snake_case</button><button class="btn" data-case="kebab">kebab-case</button></div><div class="actions"><button class="btn" id="copy">Copy</button><button class="btn" id="reset">Clear</button></div></>}
<div class="notice error hidden" id="err" style="margin-top:14px"></div>
</div>
<article class="prose" style="margin-top:34px"><h2 id="how-to-use">How to use {tool.short}</h2><p>Enter the values or text requested by the tool, run the action, then review the result before copying or using it elsewhere. Keep related inputs in the same unit, currency, reporting period, or data format.</p><h2 id="how-it-works">How it works</h2><div class="formula">{formula[tool.slug]}</div><p>The tool runs in the browser and exposes the core method instead of hiding the calculation or transformation.</p><h2 id="example">Example</h2><div class="example">{example[tool.slug]}</div><h2 id="privacy">Privacy and data processing</h2><div class="notice"><strong>Local-first:</strong> {tool.privacy}</div><h2 id="limitations">Important limitations</h2><p>Results are provided for general informational use. Verify units, assumptions, source data, and context before relying on an output for an important business, technical, security, or financial decision.</p><h2 id="faq">Frequently asked questions</h2><div class="faq"><details><summary>Does this tool send my input to Veldeonix?</summary><p>No for this release. The current implementation runs the calculation or transformation in your browser.</p></details><details><summary>Can I rely on the result without checking it?</summary><p>For low-risk everyday use, the tool is designed to be convenient. For important decisions, verify the inputs, assumptions, and result independently.</p></details></div></article>
</div><aside class="card side-card"><h3>On this page</h3><ul><li><a href="#how-to-use">How to use</a></li><li><a href="#how-it-works">How it works</a></li><li><a href="#example">Example</a></li><li><a href="#privacy">Privacy</a></li><li><a href="#limitations">Limitations</a></li><li><a href="#faq">FAQ</a></li></ul><div class="muted" style="margin-top:18px;border-top:1px solid var(--line);padding-top:14px;font-size:12px">Reviewed September 16, 2026</div></aside></div></section>
<section class="section"><div class="container"><div class="section-head"><div><h2>Related tools</h2><p>Continue with utilities that use related metrics or data.</p></div><a class="text-link" href="/tools/">All tools →</a></div><div class="grid grid-3">{rel.map(t=><a class="card card-hover tool-card" href={`/tools/${t.slug}/`}><div class="tool-icon">{t.icon}</div><h3>{t.name}</h3><p>{t.description}</p><div class="meta"><span class="badge">{t.cat}</span><span>Open tool →</span></div></a>)}</div></div></section>
</BaseLayout>
<script>
const panel=document.querySelector<HTMLElement>('[data-tool]')!;const slug=panel.dataset.tool!;const $=<T extends Element=HTMLElement>(s:string)=>panel.querySelector<T>(s)!;const err=$<HTMLElement>('#err');const nf=new Intl.NumberFormat(undefined,{maximumFractionDigits:4});const fail=(m:string)=>{err.textContent=m;err.classList.remove('hidden')};const ok=()=>err.classList.add('hidden');const copy=(text:string)=>navigator.clipboard.writeText(text);
if(['roi-calculator','roas-calculator','ctr-calculator','cpm-cpc-calculator'].includes(slug)){
 const a=$<HTMLInputElement>('#a'),b=$<HTMLInputElement>('#b'),c=panel.querySelector<HTMLInputElement>('#c'),r1=$<HTMLElement>('#r1'),r2=$<HTMLElement>('#r2');
 const calc=()=>{ok();const x=Number(a.value),y=Number(b.value),z=c?Number(c.value):0;if(!Number.isFinite(x)||!Number.isFinite(y)){fail('Enter valid numeric values.');return}
  if(slug==='roi-calculator'){if(x<=0)return fail('Investment cost must be greater than zero.');const p=y-x;r1.textContent=`${nf.format(p/x*100)}%`;r2.textContent=nf.format(p)}
  if(slug==='roas-calculator'){if(x<=0)return fail('Advertising spend must be greater than zero.');const v=y/x;r1.textContent=`${nf.format(v)}×`;r2.textContent=`${nf.format(v*100)}%`}
  if(slug==='ctr-calculator'){if(y<=0||x<0)return fail('Impressions must be greater than zero and clicks cannot be negative.');r1.textContent=`${nf.format(x/y*100)}%`;r2.textContent=nf.format(x/y*1000)}
  if(slug==='cpm-cpc-calculator'){if(x<0||y<=0||!Number.isFinite(z)||z<=0)return fail('Use valid spend and values greater than zero for impressions and clicks.');r1.textContent=nf.format(x/y*1000);r2.textContent=nf.format(x/z)}
 };
 $('#run').addEventListener('click',calc);$('#reset').addEventListener('click',()=>{a.value='';b.value='';if(c)c.value='';r1.textContent='—';r2.textContent='—';ok()});
}
if(slug==='json-formatter'){
 const text=$<HTMLTextAreaElement>('#text'),out=$<HTMLElement>('#out');const run=(space:number|undefined)=>{ok();try{out.textContent=JSON.stringify(JSON.parse(text.value),null,space)}catch(e){fail(`Invalid JSON: ${e instanceof Error?e.message:'Unable to parse input.'}`)}};$('#run').addEventListener('click',()=>run(2));$('#alt').addEventListener('click',()=>run(undefined));$('#copy').addEventListener('click',()=>copy(out.textContent||''));$('#reset').addEventListener('click',()=>{text.value='';out.textContent='Formatted JSON will appear here.';ok()});
}
if(slug==='base64-encoder-decoder'){
 const text=$<HTMLTextAreaElement>('#text'),out=$<HTMLElement>('#out');const bytes=(u:Uint8Array)=>Array.from(u,x=>String.fromCharCode(x)).join('');$('#run').addEventListener('click',()=>{ok();try{out.textContent=btoa(bytes(new TextEncoder().encode(text.value)))}catch{fail('Could not encode the input.')}});$('#alt').addEventListener('click',()=>{ok();try{const bin=atob(text.value.trim());out.textContent=new TextDecoder().decode(Uint8Array.from(bin,x=>x.charCodeAt(0)))}catch{fail('The input is not valid Base64.')}});$('#copy').addEventListener('click',()=>copy(out.textContent||''));$('#reset').addEventListener('click',()=>{text.value='';out.textContent='Output will appear here.';ok()});
}
if(slug==='uuid-generator'){
 const count=$<HTMLInputElement>('#count'),out=$<HTMLElement>('#out');const gen=()=>{const n=Math.min(20,Math.max(1,Number(count.value)||1));count.value=String(n);out.textContent=Array.from({length:n},()=>crypto.randomUUID()).join('\n')};$('#run').addEventListener('click',gen);$('#copy').addEventListener('click',()=>copy(out.textContent||''));gen();
}
if(slug==='unix-timestamp-converter'){
 const ts=$<HTMLInputElement>('#ts'),date=$<HTMLInputElement>('#date'),r1=$<HTMLElement>('#r1'),r2=$<HTMLElement>('#r2'),r3=$<HTMLElement>('#r3'),r4=$<HTMLElement>('#r4');const show=(d:Date)=>{if(Number.isNaN(d.getTime()))return fail('Enter a valid date or timestamp.');ok();r1.textContent=d.toISOString();r2.textContent=d.toLocaleString();r3.textContent=String(Math.floor(d.getTime()/1000));r4.textContent=String(d.getTime())};const now=()=>{const d=new Date();ts.value=String(Math.floor(d.getTime()/1000));date.value=new Date(d.getTime()-d.getTimezoneOffset()*60000).toISOString().slice(0,16);show(d)};$('#run').addEventListener('click',()=>{const n=Number(ts.value);show(new Date(Math.abs(n)<1e12?n*1000:n))});$('#alt').addEventListener('click',()=>show(new Date(date.value)));$('#now').addEventListener('click',now);now();
}
if(slug==='word-counter'){
 const text=$<HTMLTextAreaElement>('#text');const upd=()=>{const t=text.value,w=(t.trim().match(/\S+/g)||[]).length,s=(t.match(/[^.!?]+[.!?]+(?:\s|$)/g)||[]).length,p=t.trim()?t.trim().split(/\n\s*\n/).filter(Boolean).length:0;$<HTMLElement>('#r1').textContent=String(w);$<HTMLElement>('#r2').textContent=String(t.length);$<HTMLElement>('#r3').textContent=String(t.replace(/\s/g,'').length);$<HTMLElement>('#r4').textContent=String(s);$<HTMLElement>('#r5').textContent=String(p);$<HTMLElement>('#r6').textContent=w?`${Math.max(1,Math.ceil(w/200))} min`:'0 min'};text.addEventListener('input',upd);$('#reset').addEventListener('click',()=>{text.value='';upd()});upd();
}
if(slug==='password-generator'){
 const len=$<HTMLInputElement>('#len'),label=$<HTMLElement>('#lenLabel'),out=$<HTMLElement>('#out');const sets={lower:'abcdefghijklmnopqrstuvwxyz',upper:'ABCDEFGHIJKLMNOPQRSTUVWXYZ',number:'0123456789',symbol:'!@#$%^&*()-_=+[]{};:,.?'};const rand=(max:number)=>{const a=new Uint32Array(1),limit=Math.floor(0x100000000/max)*max;do{crypto.getRandomValues(a)}while(a[0]>=limit);return a[0]%max};const gen=()=>{ok();let chars='';for(const k of Object.keys(sets)){if($<HTMLInputElement>(`#${k}`).checked)chars+=sets[k as keyof typeof sets]}if(!chars)return fail('Select at least one character group.');out.textContent=Array.from({length:Number(len.value)},()=>chars[rand(chars.length)]).join('')};len.addEventListener('input',()=>{label.textContent=len.value;gen()});panel.querySelectorAll('input[type=checkbox]').forEach(x=>x.addEventListener('change',gen));$('#run').addEventListener('click',gen);$('#copy').addEventListener('click',()=>copy(out.textContent==='—'?'':out.textContent||''));gen();
}
if(slug==='qr-code-generator'){
 const text=$<HTMLTextAreaElement>('#text'),canvas=$<HTMLCanvasElement>('#canvas');const gen=async()=>{ok();if(!text.value.trim())return fail('Enter text or a URL first.');try{const QRCode=(await import('qrcode')).default;await QRCode.toCanvas(canvas,text.value.trim(),{width:256,margin:2,errorCorrectionLevel:'M',color:{dark:'#111111',light:'#ffffff'}})}catch{fail('Could not generate the QR code.')}};$('#run').addEventListener('click',gen);$('#download').addEventListener('click',async()=>{await gen();if(err.classList.contains('hidden')){const a=document.createElement('a');a.download='veldeonix-qr-code.png';a.href=canvas.toDataURL('image/png');a.click()}});$('#reset').addEventListener('click',()=>{text.value='';canvas.getContext('2d')?.clearRect(0,0,canvas.width,canvas.height);ok()});
}
if(slug==='case-converter'){
 const text=$<HTMLTextAreaElement>('#text');const words=(s:string)=>s.trim().replace(/([a-z0-9])([A-Z])/g,'$1 $2').split(/[^\p{L}\p{N}]+/u).filter(Boolean);const apply=(type:string)=>{const t=text.value,w=words(t);if(type==='upper')text.value=t.toUpperCase();if(type==='lower')text.value=t.toLowerCase();if(type==='title')text.value=w.map(x=>x[0]?.toUpperCase()+x.slice(1).toLowerCase()).join(' ');if(type==='sentence'){const low=t.toLowerCase();text.value=low.replace(/(^\s*\p{L}|[.!?]\s+\p{L})/gu,m=>m.toUpperCase())}if(type==='camel')text.value=w.map((x,i)=>i?x[0]?.toUpperCase()+x.slice(1).toLowerCase():x.toLowerCase()).join('');if(type==='pascal')text.value=w.map(x=>x[0]?.toUpperCase()+x.slice(1).toLowerCase()).join('');if(type==='snake')text.value=w.map(x=>x.toLowerCase()).join('_');if(type==='kebab')text.value=w.map(x=>x.toLowerCase()).join('-')};panel.querySelectorAll<HTMLElement>('[data-case]').forEach(b=>b.addEventListener('click',()=>apply(b.dataset.case||'')));$('#copy').addEventListener('click',()=>copy(text.value));$('#reset').addEventListener('click',()=>{text.value='';text.focus()});
}
</script>
