---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact" description="Contact Veldeonix Labs for general questions, privacy inquiries, corrections, or technical issues." canonical="/contact/">
<section class="page-hero"><div class="narrow"><div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>Contact</span></div><h1>Contact Veldeonix</h1><p>Use the appropriate address below. Please do not include passwords, API keys, private JSON, or other sensitive material in ordinary support email.</p></div></section>
<section class="section-tight"><div class="narrow"><div class="grid grid-2"><div class="card"><h2>General</h2><p class="muted">Tools, guides, or the Veldeonix project.</p><a class="text-link" href="mailto:hello@veldeonix.com">hello@veldeonix.com</a></div><div class="card"><h2>Privacy</h2><p class="muted">Analytics, cookies, or data handling.</p><a class="text-link" href="mailto:privacy@veldeonix.com">privacy@veldeonix.com</a></div><div class="card"><h2>Corrections</h2><p class="muted">Factual, calculation, or editorial issues.</p><a class="text-link" href="mailto:editorial@veldeonix.com">editorial@veldeonix.com</a></div><div class="card"><h2>Technical issues</h2><p class="muted">Broken tools or browser compatibility.</p><a class="text-link" href="mailto:hello@veldeonix.com?subject=Technical%20issue">hello@veldeonix.com</a></div></div><div class="notice" style="margin-top:18px">Before production, create these domain mailboxes or replace them with addresses you actively monitor.</div></div></section>
</BaseLayout>
