---
import BaseLayout from '../../layouts/BaseLayout.astro';import {guides,type Guide} from '../../data/guides';import {getTool} from '../../data/tools';
export function getStaticPaths(){return guides.map(guide=>({params:{slug:guide.slug},props:{guide}}));}
const {guide}=Astro.props as {guide:Guide};const tool=guide.tool?getTool(guide.tool):undefined;const jsonLd={'@context':'https://schema.org','@type':'Article',headline:guide.title,description:guide.description,datePublished:'2026-09-16',dateModified:'2026-09-16',author:{'@type':'Person',name:'Fajar Hidayatuloh',url:'https://veldeonix.com/authors/fajar-hidayatuloh/'},publisher:{'@type':'Organization',name:'Veldeonix Labs',url:'https://veldeonix.com/'}};
---
<BaseLayout title={guide.title} description={guide.description} canonical={`/guides/${guide.slug}/`} jsonLd={jsonLd}>
<section class="page-hero"><div class="narrow"><div class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/guides/">Guides</a><span>/</span><span>{guide.cat}</span></div><h1>{guide.title}</h1><p>{guide.description}</p><div class="author"><div class="avatar">FH</div><div><strong><a href="/authors/fajar-hidayatuloh/">Fajar Hidayatuloh</a></strong><span>Published and reviewed September 16, 2026 · {guide.minutes} min read</span></div></div></div></section>
<section class="section-tight"><article class="narrow prose">{guide.sections.map(s=><section><h2>{s.h}</h2>{s.p?.map(p=><p>{p}</p>)}{s.list&&<ul>{s.list.map(i=><li>{i}</li>)}</ul>}{s.formula&&<div class="formula">{s.formula}</div>}{s.example&&<div class="example">{s.example}</div>}</section>)}{tool&&<><h2>Related tool</h2><p>Use the <a href={`/tools/${tool.slug}/`}>{tool.name}</a> to apply this method directly in your browser.</p></>}{guide.sources&&<><h2>Sources</h2><ul>{guide.sources.map(s=><li><a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a></li>)}</ul></>}<h2>Editorial note</h2><p>Veldeonix reviews factual claims before publication and uses AI-assisted software only as a support tool. See the <a href="/legal/editorial-policy/">Editorial Policy</a> and <a href="/legal/corrections-policy/">Corrections Policy</a>.</p></article></section>
</BaseLayout>
