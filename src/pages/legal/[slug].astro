---
import BaseLayout from '../../layouts/BaseLayout.astro';import {legal,type Legal} from '../../data/legal';
export function getStaticPaths(){return legal.map(item=>({params:{slug:item.slug},props:{item}}));}const {item}=Astro.props as {item:Legal};
---
<BaseLayout title={item.title} description={item.description} canonical={`/legal/${item.slug}/`}><section class="page-hero"><div class="narrow"><div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>{item.title}</span></div><h1>{item.title}</h1><p>{item.intro}</p></div></section><section class="section-tight"><article class="narrow prose"><div class="legal-nav">{legal.map(x=><a href={`/legal/${x.slug}/`}>{x.title.replace(' Policy','').replace(' Disclosure','')}</a>)}</div>{item.sections.map(s=><section><h2>{s.h}</h2>{s.p.map(p=><p>{p}</p>)}</section>)}</article></section></BaseLayout>
