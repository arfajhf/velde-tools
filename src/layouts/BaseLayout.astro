---
import '../styles/global.css';
const {title,description,canonical=Astro.url.pathname,jsonLd,noindex=false}=Astro.props;
const site=Astro.site??new URL('https://veldeonix.com');
const full=title.includes('Veldeonix')?title:`${title} | Veldeonix Labs`;
const canon=new URL(canonical,site).toString();
const ga=import.meta.env.PUBLIC_GA_MEASUREMENT_ID||'';
const verify=import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION||'';
const path=Astro.url.pathname;
---
<!doctype html><html lang="en"><head>
<meta name="google-adsense-account" content="ca-pub-2182775434909604">
<meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="generator" content={Astro.generator}><meta name="theme-color" content="#635bff">
<title>{full}</title><meta name="description" content={description}><link rel="canonical" href={canon}><link rel="icon" href="/favicon.svg"><link rel="manifest" href="/site.webmanifest">
{noindex&&<meta name="robots" content="noindex,nofollow"/>}{verify&&<meta name="google-site-verification" content={verify}/>}<meta property="og:type" content="website"><meta property="og:site_name" content="Veldeonix Labs"><meta property="og:title" content={full}><meta property="og:description" content={description}><meta property="og:url" content={canon}><meta property="og:image" content="https://veldeonix.com/og-default.png"><meta name="twitter:card" content="summary_large_image">{jsonLd&&<script type="application/ld+json" set:html={JSON.stringify(jsonLd)}/>}<script is:inline>(()=>{try{const s=localStorage.getItem('veldeonix-theme');if(s==='dark'||(!s&&matchMedia('(prefers-color-scheme: dark)').matches))document.documentElement.dataset.theme='dark'}catch{}})()</script>
{ga&&<script is:inline define:vars={{ga}}>(()=>{const k='veldeonix-consent-v1';let loaded=false;const load=()=>{if(loaded)return;loaded=true;const s=document.createElement('script');s.async=true;s.src=`https://www.googletagmanager.com/gtag/js?id=${ga}`;document.head.appendChild(s);window.dataLayer=window.dataLayer||[];window.gtag=function(){window.dataLayer.push(arguments)};window.gtag('js',new Date());window.gtag('config',ga,{anonymize_ip:true})};try{const c=JSON.parse(localStorage.getItem(k)||'null');if(c?.analytics)load()}catch{}window.addEventListener('veldeonix:consent',(e)=>{if(e.detail?.analytics)load()})})()</script>}
</head><body>
<header class="site-header"><div class="container header-inner"><a class="brand" href="/"><img src="/favicon.svg" alt=""><span>Veldeonix <small>Labs</small></span></a><nav class="nav"><a href="/tools/" aria-current={path.startsWith('/tools')?'page':undefined}>Tools</a><a href="/guides/" aria-current={path.startsWith('/guides')?'page':undefined}>Guides</a><a href="/about/" aria-current={path==='/about/'?'page':undefined}>About</a></nav><div class="actions-head"><button class="icon-btn" id="theme" aria-label="Toggle theme">◐</button><button class="icon-btn mobile-toggle" id="menu" aria-label="Toggle menu">☰</button></div></div><nav class="container mobile-nav" id="mobile"><a href="/tools/">Tools</a><a href="/guides/">Guides</a><a href="/about/">About</a><a href="/contact/">Contact</a></nav></header>
<main><slot/></main>
<footer class="site-footer"><div class="container footer-grid"><div><a class="brand" href="/"><img src="/favicon.svg" alt=""><span>Veldeonix <small>Labs</small></span></a><p class="footer-copy">Independent digital tools and practical guides for developers, marketers, and digital creators.</p></div><div><div class="footer-title">Tools</div><div class="footer-links"><a href="/tools/developer/">Developer</a><a href="/tools/marketing/">Marketing</a><a href="/tools/productivity/">Productivity</a><a href="/tools/">All tools</a></div></div><div><div class="footer-title">Resources</div><div class="footer-links"><a href="/guides/">Guides</a><a href="/about/">About</a><a href="/how-we-create-content/">How We Create Content</a><a href="/authors/fajar-hidayatuloh/">Author</a><a href="/contact/">Contact</a></div></div><div><div class="footer-title">Policies</div><div class="footer-links"><a href="/legal/privacy-policy/">Privacy</a><a href="/legal/cookie-policy/">Cookies</a><a href="/legal/terms/">Terms</a><a href="/legal/disclaimer/">Disclaimer</a><a href="/legal/editorial-policy/">Editorial</a><a href="/legal/corrections-policy/">Corrections</a><a href="/legal/advertising-disclosure/">Advertising</a></div></div></div><div class="container footer-bottom"><div>© {new Date().getFullYear()} Veldeonix Labs.</div><span>Tools support decisions, not professional judgment.</span></div></footer>
<div class="cookie hidden" id="cookie"><h2>Your privacy choices</h2><p>Essential browser storage remembers site preferences. Optional Google Analytics loads only after you allow analytics.</p><div class="actions"><button class="btn btn-primary btn-sm" data-consent="yes">Allow analytics</button><button class="btn btn-sm" data-consent="no">Essential only</button><a class="btn btn-sm" href="/legal/cookie-policy/">Learn more</a></div></div>
<script is:inline>(()=>{const r=document.documentElement,t=document.getElementById('theme'),m=document.getElementById('menu'),n=document.getElementById('mobile');t?.addEventListener('click',()=>{const x=r.dataset.theme==='dark'?'light':'dark';r.dataset.theme=x;localStorage.setItem('veldeonix-theme',x)});m?.addEventListener('click',()=>n?.setAttribute('data-open',n?.getAttribute('data-open')==='true'?'false':'true'));const k='veldeonix-consent-v1',b=document.getElementById('cookie');if(!localStorage.getItem(k))b?.classList.remove('hidden');b?.querySelectorAll('[data-consent]').forEach(x=>x.addEventListener('click',()=>{const analytics=x.getAttribute('data-consent')==='yes';localStorage.setItem(k,JSON.stringify({analytics,savedAt:new Date().toISOString()}));b.classList.add('hidden');window.dispatchEvent(new CustomEvent('veldeonix:consent',{detail:{analytics}}))}))})()</script>
</body></html>
